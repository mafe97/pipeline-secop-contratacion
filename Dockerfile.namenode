# NameNode de Hadoop 3.2.1 + Python 3 para poder correr los mapper/reducer en Python con Hadoop Streaming.
# La imagen base es Debian 9 (stretch): sus repositorios viven ahora en archive.debian.org.
FROM bde2020/hadoop-namenode:2.0.0-hadoop3.2.1-java8
RUN sed -i 's#deb.debian.org#archive.debian.org#g; s#security.debian.org#archive.debian.org#g; /stretch-updates/d' /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --allow-unauthenticated python3 \
    && rm -rf /var/lib/apt/lists/*
